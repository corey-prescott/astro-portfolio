---
export interface Props {
  activePage?: "home" | "work" | "about";
}

const { activePage = "home" } = Astro.props;

// Define your navigation links
const navLinks = [
  { name: "Home", href: "/", id: "home" },
  { name: "Work", href: "/work", id: "work" },
  { name: "About", href: "/about", id: "about" },
];
---

<nav class="nav">
  <a href="/" class="nav-logo">Corey Prescott</a>
  <ul class="nav-links">
    {navLinks.map((link) => (
      <li>
        <a 
          href={link.href} 
          class={activePage === link.id ? "nav-link active" : "nav-link"}
        >
          {link.name}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.5rem;
    margin: 0 auto;
  }

  .nav-logo {
    font-weight: 700;
    font-size: 1.25rem;
    text-decoration: none;
    color: var(--color-text-primary, #1a1a1a);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-secondary);
    font-weight: 500;
    transition: color 0.2s ease;
    padding: 0.25rem 0;
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  /* Active state with an underline */
  .nav-link.active {
    color: var(--color-primary);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--color-secondary);
    border-radius: 2px;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .nav {
      flex-direction: column;
      gap: 0.5rem;
      padding: 1rem;
    }

    .nav-links {
      gap: 1.5rem;
      font-size: 0.95rem;
    }
  }

  /* Desktop responsive */
  @media (min-width: 768px) {
    .nav {
      gap: 0.5rem;
      padding: 1rem 3rem;
    }
  }
</style>