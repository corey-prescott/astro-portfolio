---
export interface Heading {
  slug: string;
  text: string;
  depth: number;
  url?: string; // Optional: if this is an external page link
}

export interface Props {
  headings: Heading[];
  title?: string;
}

const { headings, title = "On this page" } = Astro.props;
---

<nav class="toc" aria-label="Table of contents">
  <ul class="toc-list">
    {headings.map((heading) => (
      <li class={`toc-item toc-depth-${heading.depth}`}>
        <a 
            href={heading.url || `#${heading.slug}`} 
            class={`toc-link ${heading.url ? 'toc-link-external' : ''}`}
            >
            {heading.text}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .toc {
    position: sticky;
    top: 0;
    align-self: start;
    padding: 3rem 0;
    background: transparent;
    width: 240px;
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .toc-item {
    font-size: var(--font-size-base);
    line-height: 1;
  }

  .toc-depth-2 {
    padding-left: 0;
  }

  .toc-depth-3 {
    padding-left: 1rem;
  }

  .toc-depth-4 {
    padding-left: 2rem;
  }

  .toc-link {
    display: block;
    padding: var(--spacing-xs);
    color: var(--color-text-secondary);
    font-weight: 300;
    text-decoration: none;
    transition: all 0.2s ease;
    border-left: 2px solid transparent;
  }

  .toc-link:hover {
    color: var(--color-text-primary);
  }

  .toc-link.active {
    color: var(--color-primary);
    border-left-color: var(--color-secondary);
    font-weight: 500;
  }

  .toc-link-external {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Responsive */
  @media (max-width: 1023px) {
    .toc {
      display: none;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Get all links, but only observe those that are anchor links (not external)
    const allLinks = document.querySelectorAll(".toc-link");
    const anchorLinks = Array.from(allLinks).filter(link => {
      const href = link.getAttribute("href");
      return href && href.startsWith("#");
    });

    // Only set up Intersection Observer for anchor links
    if (anchorLinks.length > 0) {
      const sections = Array.from(anchorLinks).map((link) => {
        const href = link.getAttribute("href");
        if (href) {
          return document.querySelector(href);
        }
        return null;
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              anchorLinks.forEach((link) => {
                const href = link.getAttribute("href");
                if (href === `#${id}`) {
                  link.classList.add("active");
                } else {
                  link.classList.remove("active");
                }
              });
            }
          });
        },
        {
          rootMargin: "0px 0px -40% 0px",
          threshold: 0.1,
        }
      );

      // Only observe sections that exist
      sections.forEach((section) => {
        if (section) observer.observe(section);
      });
    }
  });
</script>