---
export interface Props {
  nextCaseStudy?: {
    title: string;
    slug: string;
    imageSrc: string;
    imageAlt: string;
  };
}

const { nextCaseStudy } = Astro.props;
---

<footer class="case-study-footer">
  <div class="footer-container">
    <div class="case-study-footer-nav">
      <a href="/work" class="back-to-work">← Back to Work</a>
      <span class="separator"> | </span>
      <a href="#top" class="back-to-top">
        ↑ Back to top
      </a>
    </div>

    <div class="case-study-footer-next">
      {nextCaseStudy && (
        <a href={`/work/${nextCaseStudy.slug}`} class="next-link">
          <span class="next-label">View next case study</span>
          <span class="next-title">{nextCaseStudy.title}</span>
          <div class="next-image-wrapper">
            <img src={nextCaseStudy.imageSrc} alt={nextCaseStudy.imageAlt} />
          </div>
        </a>
      )}
    </div>
  </div>
</footer>

<style>
  /* ===== FOOTER CONTAINER ===== */
  .case-study-footer {
    background: var(--color-background-secondary);
  }

  .footer-container {
    max-width: 800px;
    margin: 0 var(--spacing-lg);
    padding: var(--spacing-md) 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    border-top: 1px solid var(--color-border);
  }

  /* ===== LEFT SIDE ===== */
  .case-study-footer-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--font-size-sm, 0.875rem);
  }

  .back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .back-to-top:hover {
    color: var(--color-text-primary);
    transform: translateY(-2px);
  }

  .separator {
    color: var(--color-border);
  }

  .back-to-work {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-to-work:hover {
    color: var(--color-text-primary);
  }

  /* ===== RIGHT SIDE ===== */
  .case-study-footer-next {
    flex-shrink: 0;
  }

  .next-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: var(--color-text-primary);
    transition: all 0.2s ease;
  }

  .next-link:hover {
    color: var(--color-primary);
  }

  .next-label {
    font-size: var(--font-size-xs, 0.75rem);
    letter-spacing: 0.05em;
    color: var(--color-text-tertiary);
    display: block;
  }

  .next-title {
    font-size: var(--font-size-sm, 0.875rem);
    font-weight: 500;
    display: block;
  }

  .next-image-wrapper {
    position: relative;
    width: 48px;
    height: 48px;
    overflow: hidden;
  }

  .next-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .next-link:hover .next-image-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.3);
  }

  /* ===== HIDE BACK TO WORK AT 1024PX+ ===== */
  @media (min-width: 1024px) {
    .footer-container {
        margin: 0 auto;
    }
    
    .back-to-work {
      display: none;
    }

    .separator {
      display: none;
    }
  }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 768px) {
    .footer-container {
        flex-direction: column;
        align-items: stretch;
        gap: 1.5rem;
    }

    .case-study-footer-nav {
      justify-content: center;
    }

    .next-link {
      justify-content: center;
      padding: 0.75rem;
    }

    .next-label {
      font-size: var(--font-size-xs, 0.75rem);
    }

    .next-title {
      font-size: var(--font-size-sm, 0.875rem);
    }

    .next-image-wrapper {
      width: 40px;
      height: 40px;
    }
  }

  @media (max-width: 480px) {
    .case-study-footer-nav {
      flex-wrap: wrap;
      justify-content: center;
    }

    .next-link {
      flex-wrap: wrap;
      text-align: center;
    }

    .next-image-wrapper {
      width: 36px;
      height: 36px;
    }
  }
</style>