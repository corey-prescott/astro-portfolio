---
export interface Props {
  text: string;
  href: string;
  variant?: "filled" | "outline";
  size?: "sm" | "md" | "lg";
  target?: "_blank" | "_self";
  className?: string;
}

const {
  text,
  href,
  variant = "filled",
  size = "md",
  target = "_self",
  className = "",
} = Astro.props;
---

<a 
  href={href} 
  target={target}
  class={`cta-button cta-button--${variant} cta-button--${size} ${className}`}
>
  {text}
</a>

<style>
/* === BASE BUTTON STYLES === */
.cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-family-body, 'Inter', sans-serif);
  font-weight: 600;
  text-decoration: none;
  border: none;
  border-radius: 9999px; /* Pill shape */
  cursor: pointer;
  transition: all var(--transition-base, 250ms) ease;
  position: relative;
  transform: translateY(0);
  
  /* Prevent text selection */
  user-select: none;
}

/* === SIZE VARIANTS === */
.cta-button--sm {
  padding: 0.5rem 1.5rem;
  font-size: var(--font-size-sm, 0.875rem);
}

.cta-button--md {
  padding: 1rem 2.25rem;
  font-size: var(--font-size-base, 1rem);
}

.cta-button--lg {
  padding: 1rem 2.5rem;
  font-size: var(--font-size-lg, 1.125rem);
}

.cta-button--outline.cta-button--sm {
  padding: 0.375rem 1.375rem;
  font-size: var(--font-size-sm, 0.875rem);
}

.cta-button--outline.cta-button--md {
  padding: 0.875rem 2.125rem;
  font-size: var(--font-size-base, 1rem);
}

.cta-button--outline.cta-button--lg {
  padding: 0.875rem 2.375rem;
  font-size: var(--font-size-lg, 1.125rem);
}

/* === FILLED VARIANT === */
.cta-button--filled {
  background: var(--color-primary);
  color: var(--color-white);
  box-shadow: 0 4px 0 var(--color-secondary);
}

.cta-button--filled:hover {
  transform: translateY(-2px);
  background: var(--color-primary-light);
  /* color: var(--color-secondary); */
  box-shadow: 0 6px 0 var(--color-secondary);
}

.cta-button--filled:active {
  transform: translateY(2px);
  background: var(--color-primary-dark);
  color: var(--color-secondary);
  box-shadow: 0 2px 0 var(--color-secondary);
  transition-duration: 100ms;
}

/* === OUTLINE VARIANT === */
.cta-button--outline {
  background: var(--color-white);
  color: var(--color-primary);
  border: 2px solid var(--color-primary);
  box-shadow: 0 4px 0 var(--color-primary);
}

.cta-button--outline:hover {
  transform: translateY(-2px);
  background: var(--color-secondary);
  color: var(--color-primary);
  box-shadow: 0 6px 0 var(--color-primary);
}

.cta-button--outline:active {
  transform: translateY(2px);
  background: var(--color-secondary-dark);
  box-shadow: 0 2px 0 var(--color-primary);
  transition-duration: 100ms;
}

/* === RESPONSIVE === */
@media (max-width: 480px) {
  .cta-button--lg {
    padding: 0.75rem 1.75rem;
    font-size: var(--font-size-base, 1rem);
  }
}
</style>