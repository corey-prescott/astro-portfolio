---
import Layout from "../layouts/Layout.astro";

// Components
import Card from "../components/Card.astro";

// images
import flightSearchImage from "../assets/case-studies/flight-search-results/flight-search-results-card.png";
import hotelBookingImage from "../assets/case-studies/hotel-booking-flow/hotel-booking-flow-card.png";
---

<Layout title="Work: Selected projects" description="Corey Prescott's selected projects. I design with transparency and a focus on user trust, turning complex problems into clear, human-centered solutions. Explore my work." activePage="work">
<!-- Hero section -->
<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1>Work: Selected projects</h1>

            <p>I design digital experiences people can trust. For over 14 years, I've partnered with developers to turn complex problems into clear, human-centered solutions. Here are some of the projects I'm proud to share.</p>
        </div>
    </div>
</section>

<!-- Case studies section -->
<section class="case-studies-preview">
    <div class="case-studies-content">
        <h2 class="section-header">Case studies</h2>
        <div class="card-grid">
        <!-- Card 1 -->
        <Card
            title="Flight search results"
            description="Optimizing flight search results for a modern shopping experience"
            imageSrc={flightSearchImage}
            imageAlt="Flight search mockup"
            linkHref="/work/flight-search-results"
        />

        <!-- Card 2 -->
        <Card
            title="Hotel booking flow"
            description="No surprises: Designing a transparent hotel booking flow"
            imageSrc={hotelBookingImage}
            imageAlt="Hotel booking mockup"
            linkHref="/work/hotel-booking-flow"
        />
        </div>
    </div>
</section>
</Layout>

<style>
.hero-content {
    max-width: 640px;
}

.case-studies-preview {
    padding: var(--spacing-lg) 0;
    text-align: left;
    background: var(--color-background-secondary);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
}

.case-studies-content {
    max-width: 640px;
    margin: 0 var(--spacing-md);
}

/* Card component */
.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-md);
    padding-bottom: var(--spacing-xs);
}

/* === Tablet and desktop (min-width: 768px) === */
@media (min-width: 768px) {
    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .case-studies-preview {
    padding: var(--spacing-2xl) 0;
    flex-direction: row;
    align-items: center;
    }

    .case-studies-content {
        flex: 1;
        margin: 0 var(--spacing-lg);
    }
}

/* === Desktop (min-width: 1024px) === */
@media (min-width: 1024px) {

}
</style>