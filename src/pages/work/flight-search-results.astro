---
import Layout from "../../layouts/Layout.astro";
import "../../styles/case-study.css";
import TableOfContents from "../../components/TableOfContents.astro";
import { Image } from "astro:assets";

// images
import flightSearchHero from "../../assets/case-studies/flight-search-results/flight-search-hero.png";
import flightSearchScreens from "../../assets/case-studies/flight-search-results/flight-screens.png";
import searchResultsOld from "../../assets/case-studies/flight-search-results/search-results_desktop_old.png";
import searchResultsMobile from "../../assets/case-studies/flight-search-results/results_mobile.png"
import fareSelectMobile from "../../assets/case-studies/flight-search-results/fare-select_mobile.png";
import fareSelectMobileMain from "../../assets/case-studies/flight-search-results/fare-select-main-cabin_mobile.png";
import itineraryMobile from "../../assets/case-studies/flight-search-results/itinerary_mobile.png";
import itineraryRoundtripMobile from "../../assets/case-studies/flight-search-results/itinerary-roundtrip_mobile.png";
import resultsV2VLoggedIn from "../../assets/case-studies/flight-search-results/results-v2v-logged-in_mobile.png";
import resultsV2VLoggedOut from "../../assets/case-studies/flight-search-results/results-v2v-logged-out_mobile.png";

const tocHeadings = [
  { slug: "project-overview", text: "Project overview", depth: 2 },
  { slug: "the-need-for-a-redesign", text: "The need for a redesign", depth: 2 },
  { slug: "solution", text: "Solution", depth: 2 },
  { slug: "comparing-results", text: "Comparing results", depth: 2 },
  { slug: "exclusive-pricing", text: "Exclusive pricing", depth: 2 },
  { slug: "flight-details", text: "Flight details", depth: 2 },
  { slug: "fare-select", text: "Fare select", depth: 2 },
  { slug: "results", text: "Results", depth: 2 },
];
---

<Layout title="Optimizing flight search results for a modern shopping experience | My Portfolio" activePage="work">
<article>
    <!-- Header -->
    <section class="hero">
        <div class="hero-content">
            <div class="hero-text">
                <h1>Optimizing flight search results for a modern shopping experience</h1>
                <p class="company-name">StudentUniverse</p>
            </div>

            <div class="hero-image">
                <Image src={flightSearchHero} alt="Hero" />
            </div>
        </div>
    </section>

    <section class="main-content">
        <div class="case-study-layout">
            <aside class="case-study-sidebar">
                <TableOfContents headings={tocHeadings} />
            </aside>

            <div class="case-study-content">
                <!-- Project overview -->
                <section class="project-overview" id="project-overview" aria-labelledby="project-overview-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="project-overview-heading">Project overview</h2>
                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Redesign the flight search results within the existing search results page</h3>
                                    <p>The way we receive and display flight data is being changed due to updated airline contracts and distribution systems. This change prompted us to take a look into modernizing our results as a whole. This update would also include a much needed improvement to our mobile experience. Updating the filters would not be a part of this project.</p>
                                </div>
                            </div>
                        </div>

                        <div class="callout">
                            <div class="callout-grid">
                                <div class="callout-category">
                                    <h3>My role</h3>
                                    <ul>
                                        <li>Product Designer</li>
                                    </ul>
                                </div>

                                <div class="callout-category">
                                    <h3>Team</h3>
                                    <ul>
                                        <li>Product Manager</li>
                                        <li>Front-end Engineer</li>
                                        <li>UX Designer</li>
                                    </ul>
                                </div>

                                <div class="callout-category">
                                    <h3>Tools</h3>
                                    <ul>
                                        <li>Figma</li>
                                        <li>Useberry</li>
                                        <li>Jira</li>
                                        <li>Hotjar</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- The need for a redesign -->
                <section class="the-need-for-a-redesign" id="the-need-for-a-redesign" aria-labelledby="the-need-for-a-redesign-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="the-need-for-a-redesign-heading">The need for a redesign</h2>

                            <!-- <h3>Business and user needs</h3> -->

                            <!-- <div class="feature-grid">
                                <div class="feature-item">
                                    <p>Multiple distinguished <strong>cabin types</strong></p>
                                </div>

                                <div class="feature-item">
                                    <p>Call out specific <strong>student rates</strong></p>
                                </div>

                                <div class="feature-item">
                                    <p><strong>Our value</strong> should be easy to see</p>
                                </div>

                                <div class="feature-item">
                                    <p><strong>Amenities</strong> are clear at each price point</p>
                                </div>

                                <div class="feature-item">
                                    <p><strong>Mobile</strong> is not user-friendly or accessible</p>
                                </div>

                                <div class="feature-item">
                                    <p><strong>Easy to compare</strong> to other sites</p>
                                </div>

                                <div class="feature-item">
                                    <p><strong>Marketing and promotions</strong> play a major role in sales</p>
                                </div>
                            </div> -->

                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Only showing one <strong>cabin type</strong></h3>
                                </div>

                                <div class="feature-item">
                                    <h3><strong>Student rates</strong> not called out</h3>
                                </div>

                                <div class="feature-item">
                                    <h3>Hard to see <strong>our value</strong></h3>
                                </div>

                                <div class="feature-item">
                                    <h3><strong>Mobile</strong> is not user-friendly or accessible</h3>
                                </div>

                                <div class="feature-item">
                                    <h3><strong>Amenities</strong> are not shown</h3>
                                </div>

                                <div class="feature-item">
                                    <h3>Hard to <strong>compare to other sites</strong></h3>
                                </div>

                                <div class="feature-item">
                                    <h3><strong>Marketing and promotions</strong> not shown</h3>
                                </div>
                            </div>
                        </div>

                        <div class="section-body-image">
                            <figure class="image-figure">
                                <div class="image-wrapper desktop-screen">
                                    <Image src={searchResultsOld} alt="Old fare select" />
                                </div>
                                <figcaption>Curent search results (No access to mobile screens)</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <!-- Solution -->
                <section class="solution" id="solution" aria-labelledby="solution-heading">
                    <h2 class="section-header" id="solution-heading">Solution</h2>

                    <div class="section-body">
                        <div class="section-body-image">
                            <figure class="image-figure">
                                <div class="image-wrapper desktop-screen">
                                    <Image src={flightSearchScreens} alt="Flight search results" />
                                </div>
                            </figure>
                        </div>
                    </div>
                </section>

                <!-- Comparing results -->
                <section class="comparing-results" id="comparing-results" aria-labelledby="comparing-results-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="comparing-results-heading">Comparing results</h2>

                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Itineraries</h3>
                                    <p>Stop locations are now exposed instead of behind a click.</p>
                                </div>

                                <div class="feature-item">
                                    <h3>Cabin types</h3>
                                    <p>Three categories of cabin types are now shown on a single result, resulting in easier comparison within a single itinerary.</p>
                                </div>

                                <div class="feature-item">
                                    <h3>Sales and promotions</h3>
                                    <p>Dynamic discounts and promos are shown within specific results instead of general placements. Savings are now reflected in the price shown.</p>
                                </div>

                                <div class="feature-item">
                                    <h3>Mobile improvements</h3>
                                    <p>A core goal of this redesign was to improve the mobile experience, including increased touch target sizing and mobile-specific interactions/behaviors. Mobile screens will be used for all examples moving forward.</p>
                                </div>
                            </div>
                        </div>

                        <div class="section-body-image">
                            <!-- <figure class="image-figure">
                                <div class="image-wrapper">
                                    <Image src={searchResultsDesktop} alt="Search results desktop" />
                                </div>
                                <figcaption>New desktop search results view</figcaption>
                            </figure> -->

                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={searchResultsMobile} alt="Search results mobile" />
                                </div>
                                <figcaption>New search results</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <!-- Exclusive pricing -->
                <section class="exclusive-pricing" id="exclusive-pricing" aria-labelledby="exclusive-pricing-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="exclusive-pricing-heading">Exclusive pricing</h2>

                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Verify to view</h3>
                                    <p>Our best deals are locked behind verified student accounts. Any results locked behind this are wrapped up into a single result. These results are shown individually once logged in with a banner and member-colored prices. Exclusive deals had previously been unclear on a per-result basis, as they didn't have anything calling them out.</p>
                                </div>
                            </div>
                        </div>

                        <div class="section-body-image">
                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={resultsV2VLoggedOut} alt="Verify to view results logged out" />
                                </div>
                                <figcaption>Logged out</figcaption>
                            </figure>

                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={resultsV2VLoggedIn} alt="Verify to view results logged in" />
                                </div>
                                <figcaption>Logged in</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <!-- Flight details -->
                <section class="flight-details" id="flight-details" aria-labelledby="flight-details-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="flight-details-heading">Flight details</h2>

                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Mobile-friendly</h3>
                                    <p>Flight details have been separated from fare selection and now show in a modal rather than expanding the result down vertically, often off screen. Because of the separation, the primary action is to move forward to fare select.</p>
                                </div>
                            </div>
                        </div>

                        <div class="section-body-image">
                            <!-- <figure class="image-figure">
                                <div class="image-wrapper">
                                    <Image src={itineraryDesktop} alt="Itinerary desktop" />
                                </div>
                                <figcaption>One-way flight</figcaption>
                            </figure> -->

                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={itineraryMobile} alt="Itinerary mobile" />
                                </div>
                                <figcaption>One-way flight</figcaption>
                            </figure>

                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={itineraryRoundtripMobile} alt="Itinerary roudntrip mobile" />
                                </div>
                                <figcaption>Roundtrip flight</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <!-- Fare select -->
                <section class="fare-select" id="fare-select" aria-labelledby="fare-select-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="fare-select-heading">Fare select</h2>

                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Multiple options per cabin</h3>
                                    <p>The cabin type clicked within the result is anchored to, but all cabin types are available along with their airline specific terminology for comparison with the airline and other sites.</p>
                                </div>

                                <div class="feature-item">
                                    <h3>Compare amenities</h3>
                                    <p>Included amenities are clearly shown with symbols, color, and language to convey availability across all cabin types.</p>
                                </div>
                            </div>
                        </div>

                        <div class="section-body-image">
                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={fareSelectMobile} alt="Fare select mobile" />
                                </div>
                                <figcaption>Basic cabin type chosen</figcaption>
                            </figure>

                            <figure class="image-figure">
                                <div class="image-wrapper mobile-screen">
                                    <Image src={fareSelectMobileMain} alt="Fare select mobile" />
                                </div>
                                <figcaption>Main cabin type chosen</figcaption>
                            </figure>
                        </div>
                    </div>
                </section>

                <!-- Results -->
                <section class="results" id="results" aria-labelledby="results-heading">
                    <div class="section-body">
                        <div class="section-body-text">
                            <h2 class="section-header" id="results-heading">Results</h2>

                            <div class="feature-grid">
                                <div class="feature-item">
                                    <h3>Conversion and total bookings increased</h3>
                                    <p>Users who clicked through were ready to book.</p>
                                </div>

                                <div class="feature-item">
                                    <h3>Fewer abandoned carts</h3>
                                    <p>Visible pricing upfront meant fewer surprises at checkout.</p>
                                </div>

                                <div class="feature-item">
                                    <h3>Lower click-through rate, by design</h3>
                                    <p>Users weren't wasting time going back and forth to get the information they needed to make a decision.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            </div>
        </div>
    </section>
</article>
</Layout>

<style>
    /* Section specific styles */
    .the-need-for-a-redesign .feature-grid {
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-sm) var(--spacing-lg);
    }

    .the-need-for-a-redesign .feature-grid h3 {
        font-size: var(--font-size-lg);
        font-weight: 300;
    }

    .the-need-for-a-redesign .feature-grid h3 strong {
        font-weight: 600;
    }

    .solution .section-body-image {
        grid-template-columns: 1fr;
    }

    @media (min-width: 768px) {
        /* Section specific styles */
        .project-overview .section-body {
            grid-template-columns: 3fr 1fr;
        }

            /* Slightly smaller spacing to balance with callout */
        .project-overview .section-body-text {
            margin-bottom: var(--spacing-md);
        }

        .the-need-for-a-redesign .section-body {
            grid-template-columns: 1fr;
        }
        
        .the-need-for-a-redesign .section-body-text {
            margin-bottom: 0;
        }

        .the-need-for-a-redesign .feature-grid {
            grid-template-columns: 1fr 1fr 1fr;
            gap: var(--spacing-sm) var(--spacing-lg);
        }

        .solution {
            padding-bottom: var(--spacing-2xl);
        }

        .solution .section-body {
            grid-template-columns: auto;
        }

        .solution .section-header {
            margin-bottom: var(--spacing-lg);
        }

        .comparing-results .section-body {
            grid-template-columns: 2fr 1fr;
        }

        .comparing-results .feature-grid {
            grid-template-columns: 1fr 1fr;
        }

        .exclusive-pricing .section-body {
            grid-template-columns: 1fr 2fr;
        }

        .flight-details .section-body {
            grid-template-columns: 1fr 2fr;
        }

        .fare-select .section-body {
            grid-template-columns: 1fr 2fr;
        }

        .results .feature-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

@media (min-width: 1024px) {
    .the-need-for-a-redesign .feature-grid {
        grid-template-columns: 1fr 1fr 1fr 1fr;
    }
}
</style>