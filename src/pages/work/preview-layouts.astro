---
// src/pages/work/preview-layouts.astro
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";

// Placeholder images - replace with your actual images
// For preview purposes, I'm using placeholder URLs
const step1Mobile = "https://placehold.co/300x600/1a1a1a/FFFFFF?text=Step+1";
const step2Mobile = "https://placehold.co/300x600/2a2a2a/FFFFFF?text=Step+2";
const step3Mobile = "https://placehold.co/300x600/3a3a3a/FFFFFF?text=Step+3";
const desktopDashboard = "https://placehold.co/800x500/4a4a4a/FFFFFF?text=Desktop+Dashboard";
---

<Layout title="Layout Previews | My Portfolio" activePage="work">
  <div class="preview-page">
    <h1>Case Study Layout Previews</h1>
    <p class="intro">Five creative ways to showcase mobile and desktop screenshots in your case study.</p>

    <!-- ============================================================ -->
    <!-- APPROACH 1: SPLIT LAYOUT -->
    <!-- ============================================================ -->
    <section class="preview-section">
      <h2>Approach 1: Split Layout</h2>
      <p>Mobile screens in a grid, desktop as a full-width breakout.</p>
      
      <div class="approach approach-1">
        <div class="mobile-grid">
          <figure class="phone-frame">
            <img src={step1Mobile} alt="Mobile step 1" />
            <figcaption>Step 1: Selecting flights</figcaption>
          </figure>
          <figure class="phone-frame">
            <img src={step2Mobile} alt="Mobile step 2" />
            <figcaption>Step 2: Comparing options</figcaption>
          </figure>
          <figure class="phone-frame">
            <img src={step3Mobile} alt="Mobile step 3" />
            <figcaption>Step 3: Booking confirmation</figcaption>
          </figure>
        </div>
        
        <figure class="desktop-breakout">
          <img src={desktopDashboard} alt="Desktop dashboard" />
          <figcaption>Desktop dashboard view</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- APPROACH 2: TOGGLE VIEW -->
    <!-- ============================================================ -->
    <section class="preview-section">
      <h2>Approach 2: Toggle View</h2>
      <p>Let users switch between mobile and desktop views.</p>
      
      <div class="approach approach-2">
        <div class="view-toggle">
          <button class="toggle-btn active" data-view="mobile">📱 Mobile</button>
          <button class="toggle-btn" data-view="desktop">💻 Desktop</button>
        </div>

        <div class="view-content" data-view="mobile">
          <div class="mobile-grid">
            <figure class="phone-frame">
              <img src={step1Mobile} alt="Step 1" />
              <figcaption>Step 1</figcaption>
            </figure>
            <figure class="phone-frame">
              <img src={step2Mobile} alt="Step 2" />
              <figcaption>Step 2</figcaption>
            </figure>
            <figure class="phone-frame">
              <img src={step3Mobile} alt="Step 3" />
              <figcaption>Step 3</figcaption>
            </figure>
          </div>
        </div>

        <div class="view-content" data-view="desktop" style="display: none;">
          <figure class="desktop-full">
            <img src={desktopDashboard} alt="Desktop view" />
            <figcaption>Desktop dashboard</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- APPROACH 3: CAROUSEL -->
    <!-- ============================================================ -->
    <section class="preview-section">
      <h2>Approach 3: Device Frame Carousel</h2>
      <p>Scrollable carousel for mobile, full-width desktop.</p>
      
      <div class="approach approach-3">
        <div class="carousel-container">
          <div class="phone-carousel">
            <div class="phone-frame">
              <img src={step1Mobile} alt="Step 1" />
              <p class="label">Step 1: Select flights</p>
            </div>
            <div class="phone-frame">
              <img src={step2Mobile} alt="Step 2" />
              <p class="label">Step 2: Compare options</p>
            </div>
            <div class="phone-frame">
              <img src={step3Mobile} alt="Step 3" />
              <p class="label">Step 3: Book</p>
            </div>
          </div>
        </div>
        
        <figure class="desktop-full">
          <img src={desktopDashboard} alt="Desktop dashboard" />
          <figcaption>Desktop dashboard showing all flight options at a glance</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- APPROACH 4: DESIGN SYSTEM GRID -->
    <!-- ============================================================ -->
    <section class="preview-section">
      <h2>Approach 4: Design System Grid</h2>
      <p>Show all devices together in a cohesive grid.</p>
      
      <div class="approach approach-4">
        <div class="device-grid">
          <div class="mobile-group">
            <figure class="phone-frame">
              <img src={step1Mobile} alt="Step 1" />
              <figcaption>Step 1</figcaption>
            </figure>
            <figure class="phone-frame">
              <img src={step2Mobile} alt="Step 2" />
              <figcaption>Step 2</figcaption>
            </figure>
            <figure class="phone-frame">
              <img src={step3Mobile} alt="Step 3" />
              <figcaption>Step 3</figcaption>
            </figure>
          </div>
          <figure class="desktop-screenshot">
            <img src={desktopDashboard} alt="Desktop dashboard" />
            <figcaption>Desktop dashboard</figcaption>
          </figure>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- APPROACH 5: ANNOTATED SCREENSHOTS -->
    <!-- ============================================================ -->
    <section class="preview-section">
      <h2>Approach 5: Annotated Screenshots</h2>
      <p>Add interactive callouts to explain key features.</p>
      
      <div class="approach approach-5">
        <figure class="annotated-screenshot">
          <div class="image-container">
            <img src={desktopDashboard} alt="Desktop dashboard with annotations" />
            <div class="annotation" style="top: 15%; left: 10%;">
              <span class="dot">1</span>
              <div class="tooltip">Search bar with improved filters</div>
            </div>
            <div class="annotation" style="top: 40%; right: 8%;">
              <span class="dot">2</span>
              <div class="tooltip">Results sorted by price and time</div>
            </div>
            <div class="annotation" style="bottom: 20%; left: 25%;">
              <span class="dot">3</span>
              <div class="tooltip">Quick booking CTA</div>
            </div>
          </div>
          <figcaption>Desktop dashboard with key annotations</figcaption>
        </figure>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* ========================================
     PAGE LAYOUT
     ======================================== */
  .preview-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .preview-page h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .preview-page .intro {
    font-size: 1.1rem;
    color: var(--color-text-secondary, #666);
    margin-bottom: 3rem;
  }

  .preview-section {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 2px solid var(--color-border, #e6e6e6);
  }

  .preview-section:last-child {
    border-bottom: none;
  }

  .preview-section h2 {
    font-size: 1.5rem;
    margin-bottom: 0.25rem;
  }

  .preview-section > p {
    color: var(--color-text-secondary, #666);
    margin-bottom: 1.5rem;
  }

  .approach {
    padding: 1.5rem;
    background: var(--color-background-alt, #f7f7f7);
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border, #e6e6e6);
  }

  /* ========================================
     SHARED STYLES
     ======================================== */
  .phone-frame {
    background: #1a1a1a;
    border-radius: 24px;
    padding: 12px 6px 6px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.15);
    position: relative;
    max-width: 200px;
    margin: 0 auto;
  }

  .phone-frame::before {
    content: '● ● ●';
    position: absolute;
    top: 4px;
    left: 50%;
    transform: translateX(-50%);
    color: #333;
    font-size: 6px;
    letter-spacing: 4px;
  }

  .phone-frame img {
    border-radius: 12px;
    width: 100%;
    height: auto;
    display: block;
  }

  .phone-frame figcaption,
  .phone-frame .label {
    text-align: center;
    font-size: 0.8rem;
    color: var(--color-text-secondary, #666);
    margin-top: 0.5rem;
  }

  .mobile-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.5rem;
    margin: 1.5rem 0;
  }

  figure {
    margin: 0;
  }

  figure figcaption {
    text-align: center;
    font-size: 0.875rem;
    color: var(--color-text-secondary, #666);
    margin-top: 0.5rem;
  }

  .desktop-breakout {
    margin: 1.5rem 0;
  }

  .desktop-breakout img,
  .desktop-full img,
  .desktop-screenshot img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border, #e6e6e6);
  }

  /* ========================================
     APPROACH 2: TOGGLE
     ======================================== */
  .view-toggle {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    justify-content: center;
  }

  .toggle-btn {
    padding: 0.5rem 1.5rem;
    border: 2px solid var(--color-border, #e6e6e6);
    background: var(--color-background, #ffffff);
    border-radius: var(--radius-full, 9999px);
    cursor: pointer;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .toggle-btn.active {
    background: var(--color-primary, #0055ff);
    color: white;
    border-color: var(--color-primary, #0055ff);
  }

  .toggle-btn:hover:not(.active) {
    background: var(--color-background-alt, #f7f7f7);
  }

  /* ========================================
     APPROACH 3: CAROUSEL
     ======================================== */
  .phone-carousel {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding: 1rem 0.5rem;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  .phone-carousel .phone-frame {
    flex: 0 0 150px;
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .phone-carousel {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      overflow-x: visible;
      padding: 0;
    }
  }

  /* ========================================
     APPROACH 4: DESIGN SYSTEM GRID
     ======================================== */
  .device-grid {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 2rem;
    align-items: start;
  }

  .device-grid .mobile-group {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .device-grid .mobile-group .phone-frame {
    max-width: 100%;
  }

  .device-grid .desktop-screenshot img {
    border-radius: var(--radius-md, 8px);
  }

  @media (max-width: 768px) {
    .device-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .device-grid .mobile-group {
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    }
  }

  /* ========================================
     APPROACH 5: ANNOTATED SCREENSHOTS
     ======================================== */
  .image-container {
    position: relative;
    display: inline-block;
    width: 100%;
  }

  .image-container img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md, 8px);
    border: 1px solid var(--color-border, #e6e6e6);
  }

  .annotation {
    position: absolute;
    cursor: pointer;
  }

  .annotation .dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--color-primary, #0055ff);
    color: white;
    border-radius: 50%;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 85, 255, 0.4);
    transition: transform 0.2s ease;
  }

  .annotation:hover .dot {
    transform: scale(1.1);
  }

  .annotation .tooltip {
    display: none;
    position: absolute;
    background: white;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm, 4px);
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.1));
    font-size: 0.8rem;
    white-space: nowrap;
    left: 50%;
    transform: translateX(-50%);
    bottom: calc(100% + 8px);
    color: var(--color-text-primary, #1a1a1a);
    border: 1px solid var(--color-border, #e6e6e6);
  }

  .annotation .tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: white;
  }

  .annotation:hover .tooltip {
    display: block;
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 640px) {
    .preview-page {
      padding: 1rem;
    }

    .preview-page h1 {
      font-size: 1.75rem;
    }

    .approach {
      padding: 0.75rem;
    }

    .mobile-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .phone-frame {
      max-width: 140px;
    }

    .annotation .tooltip {
      font-size: 0.65rem;
      padding: 0.25rem 0.5rem;
      white-space: normal;
      max-width: 120px;
    }
  }
</style>

<!-- ============================================================ -->
<!-- TOGGLE SCRIPT -->
<!-- ============================================================ -->
<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtns = document.querySelectorAll('.toggle-btn');
    
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const container = btn.closest('.approach-2');
        if (!container) return;
        
        const parentToggle = container.querySelector('.view-toggle');
        if (parentToggle) {
          parentToggle.querySelectorAll('.toggle-btn').forEach(b => {
            b.classList.remove('active');
          });
        }
        btn.classList.add('active');
        
        const view = btn.dataset.view;
        if (!view) return;
        
        container.querySelectorAll('.view-content').forEach(el => {
          el.style.display = el.dataset.view === view ? 'block' : 'none';
        });
      });
    });
  });
</script>