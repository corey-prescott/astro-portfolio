---
import Layout from "../../layouts/Layout.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { Image } from "astro:assets";

// images
import flightSearchHero from "../../assets/case-studies/flight-search-results/flight-search-results-card.png";
import searchResultsOld from "../../assets/case-studies/flight-search-results/search-results_desktop_old.png";
import searchResultsDesktop from "../../assets/case-studies/flight-search-results/results_desktop.png";
import searchResultsMobile from "../../assets/case-studies/flight-search-results/results_mobile.png";
import fareSelectDesktop from "../../assets/case-studies/flight-search-results/fare-select_desktop.png";
import fareSelectMobile from "../../assets/case-studies/flight-search-results/fare-select_mobile.png";
import itineraryDesktop from "../../assets/case-studies/flight-search-results/itinerary_desktop.png";
import itineraryMobile from "../../assets/case-studies/flight-search-results/itinerary_mobile.png";
import itineraryRoundtripMobile from "../../assets/case-studies/flight-search-results/itinerary-roundtrip_mobile.png";
import resultsV2VLoggedIn from "../../assets/case-studies/flight-search-results/results-v2v-logged-in_mobile.png";
import resultsV2VLoggedOut from "../../assets/case-studies/flight-search-results/results-v2v-logged-out_mobile.png";
---

<Layout title="Optimizing flight search results for a modern shopping experience | My Portfolio" activePage="work">
<section class="comparing-results" aria-labelledby="comparing-results">
  <div class="section-container">
    <!-- Section Header -->
    <div class="section-header-wrapper">
      <span class="section-number">02</span>
      <h2 class="section-header" id="comparing-results">Comparing results</h2>
      <p class="section-subtitle">
        Making it easier for users to evaluate flights side-by-side
      </p>
    </div>

    <!-- Content Grid -->
    <div class="section-body">
      <!-- Text Content -->
      <div class="section-body-text">
        <div class="feature-grid">
          <div class="feature-item">
            <div class="feature-icon">✈️</div>
            <div>
              <h3>Itineraries</h3>
              <p>Stop locations are now exposed instead of behind a click.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">🛏️</div>
            <div>
              <h3>Cabin types</h3>
              <p>Three categories of cabin types are now shown on a single result, resulting in easier comparison within a single itinerary.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">🏷️</div>
            <div>
              <h3>Sales and promotions</h3>
              <p>Dynamic discounts and promos are shown within specific results instead of general placements. Savings are now reflected in the price shown.</p>
            </div>
          </div>

          <div class="feature-item">
            <div class="feature-icon">📱</div>
            <div>
              <h3>Mobile improvements</h3>
              <p>A core goal of this redesign was to improve the mobile experience, including increased touch target sizing and mobile-specific interactions/behaviors. Mobile screens will be used for all examples moving forward.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Images -->
      <div class="section-body-image">
        <figure class="image-figure">
          <div class="image-wrapper">
            <Image src={searchResultsDesktop} alt="Search results desktop" />
          </div>
          <figcaption>New desktop search results view</figcaption>
        </figure>

        <figure class="image-figure">
          <div class="image-wrapper">
            <Image src={searchResultsMobile} alt="Search results mobile" />
          </div>
          <figcaption>New mobile search results view</figcaption>
        </figure>
      </div>
    </div>
  </div>
</section>
</Layout>

<style>
  /* ========================================
     SECTION CONTAINER
     ======================================== */
  .comparing-results {
    padding: 4rem 0;
    background: var(--color-background, #ffffff);
  }

  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ========================================
     SECTION HEADER
     ======================================== */
  .section-header-wrapper {
    margin-bottom: 3rem;
    text-align: center;
  }

  .section-number {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary, #0055ff);
    background: var(--color-primary-light, #e8eeff);
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full, 9999px);
    margin-bottom: 0.75rem;
  }

  .section-header {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--color-text-primary, #1a1a1a);
  }

  .section-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-secondary, #666);
    max-width: 600px;
    margin: 0 auto;
  }

  /* ========================================
     CONTENT GRID
     ======================================== */
  .section-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
  }

  /* ========================================
     TEXT CONTENT
     ======================================== */
  .feature-grid {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .feature-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .feature-icon {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-background-alt, #f7f7f7);
    border-radius: var(--radius-md, 8px);
    font-size: 1.2rem;
  }

  .feature-item h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.25rem 0;
    color: var(--color-text-primary, #1a1a1a);
  }

  .feature-item p {
    font-size: 0.95rem;
    color: var(--color-text-secondary, #666);
    line-height: 1.6;
    margin: 0;
  }

  /* ========================================
     IMAGES
     ======================================== */
  .section-body-image {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .image-figure {
    margin: 0;
    background: var(--color-background-alt, #f7f7f7);
    border-radius: var(--radius-md, 8px);
    overflow: hidden;
    border: 1px solid var(--color-border, #e6e6e6);
    transition: box-shadow 0.3s ease;
  }

  .image-figure:hover {
    box-shadow: var(--shadow-md, 0 4px 12px rgba(0,0,0,0.08));
  }

  .image-wrapper {
    position: relative;
    overflow: hidden;
    background: #f0f0f0;
  }

  .image-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .image-figure figcaption {
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary, #666);
    background: var(--color-background, #ffffff);
    border-top: 1px solid var(--color-border, #e6e6e6);
    text-align: center;
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 1024px) {
    .section-body {
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .section-body {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .section-body-image {
      order: -1; /* Images appear above text on mobile */
    }

    .feature-grid {
      gap: 1.5rem;
    }

    .feature-item {
      gap: 0.75rem;
    }

    .comparing-results {
      padding: 2.5rem 0;
    }

    .section-header-wrapper {
      margin-bottom: 2rem;
    }
  }

  @media (max-width: 480px) {
    .feature-item {
      flex-direction: column;
      align-items: flex-start;
    }

    .feature-icon {
      width: 2rem;
      height: 2rem;
      font-size: 1rem;
    }

    .section-subtitle {
      font-size: 1rem;
    }
  }
</style>