---
import Layout from "../layouts/Layout.astro";
---

<Layout title="About me | Corey Prescott" activePage="about">
<!-- Hero section -->
<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1>About me</h1>
        </div>
    </div>
</section>

<!-- About me section -->
<section class="about-me">
    <div class="about-content">
        <h2 class="section-header">Hi, I'm Corey 👋</h2>
        <p>I'm a Product Designer with over 14 years designing and building for the web, the last 4 focused specifically on product and UX. I care about designing experiences people can trust, where the information they need is upfront, not buried.</p>

        <p>Much of my time in product design has been spent working closely with development, figuring out where the real edges of an idea are and pushing a little past them.</p>

        <p>My background is primarily in travel and e-commerce, but I'm looking to bring that same approach, transparency, trust, and close collaboration with engineering, to new industries.</p>
    </div>
</section>
</Layout>

<style>
/* About me */
.about-me {
    padding: var(--spacing-lg) 0;
    text-align: left;
    background: var(--color-background-secondary);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
}

.about-content {
    max-width: 1200px;
    margin: 0 var(--spacing-md);
}

.about-me p {
    max-width: 40em;
}

/* === Tablet and desktop (min-width: 768px) === */
@media (min-width: 768px) {
    .about-me {
        padding: var(--spacing-2xl) 0;
        flex-direction: row;
        align-items: center;
    }

    .about-content {
        flex: 1;
        margin: 0 var(--spacing-lg);
    }
}
</style>