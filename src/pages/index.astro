---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import CTAButton from "../components/CTAButton.astro";
import Card from "../components/Card.astro";
---

<Layout title="Home | Corey Prescott">
  <!-- Hero section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Corey Prescott</h1>
      <h2>Product Designer</h2>
      <CTAButton text="View my work" href="/work" size="md" />
      <CTAButton text="View my work" href="/work" size="md" variant="outline" />
    </div>
  </section>

  <!-- About preview section -->
  <section class="about-preview">
    <h2>About me</h2>
    <p>I care about designing experiences people can trust, where the information they need is upfront, not buried. I've been designing for the web for over 14 years, with the last 4 focused on product and UX. Much of that time has been spent working closely with development, figuring out where the real edges of an idea are and pushing a little past them.</p>
    <a href="/about">Learn more →</a>
  </section>

  <!-- Case studies section -->
  <section class="case-studies-preview">
    <h2>Case studies</h2>
    <div class="card-grid">
    <!-- Card 1 -->
    <Card
        title="Flight search results"
        description="Optimizing flight search results for a modern shopping experience"
        imageSrc="../assets/images/case-studies/flight-search-results/flight-search-results-card.png"
        imageAlt="Flight search mockup"
        linkHref="/work/flight-search-results"
        linkText="Read the case study →"
    />

    <!-- Card 2 -->
    <Card
        title="Hotel booking flow"
        description="No surprises: Designing a transparent hotel booking flow"
        imageSrc="../assets/images/case-studies/hotel-booking-flow/hotel-booking-flow-card.png"
        imageAlt="Hotel booking mockup"
        linkHref="/work/hotel-booking-flow"
        linkText="Read the case study →"
    />
    </div>
  </section>
</Layout>

<style>
  /* Reset and base */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Hero section */
  .hero {
    padding: 2rem 1.5rem;
    text-align: left;
    background: var(--color-background-secondary);
    height: 66vh;
    max-height: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--color-text-primary);
  }

  .hero h2 {
    margin-bottom: 2rem;
  }

  .hero p {
    font-size: 1.2rem;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .cta {
    display: inline-block;
    background: var(--color-primary);
    color: var(--color-text-primary);
    padding: 0.8rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }

  .hero-image {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  /* About preview */
  .about-preview, .case-studies-preview {
    padding: 3rem 1rem;
    text-align: left;
    background: var(--color-white);
  }

  .about-preview h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .about-preview p {
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .about-preview a {
    color: var(--color-link);
    text-decoration: none;
    font-weight: 600;
  }

  .view-all {
    color: var(--color-link);
    text-decoration: none;
    font-weight: 600;
  }

  /* Card component */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    padding: 2rem 0;
  }

  /* === Tablet and desktop (min-width: 768px) === */
  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      text-align: left;
      padding: 4rem 3rem;
      gap: 4rem;
    }

    .hero-content {
      flex: 1;
    }

    .hero-image {
      flex: 1;
      max-width: 400px;
    }

    .hero h1 {
      font-size: 3.5rem;
    }

    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-preview, .case-studies-preview {
      padding: 4rem 3rem;
    }
  }

  /* === Desktop (min-width: 1024px) === */
  @media (min-width: 1024px) {
    .hero {
      padding: 6rem 4rem;
    }

    .hero-image {
      max-width: 500px;
    }
  }
</style>