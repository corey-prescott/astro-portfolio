---
import Layout from "../layouts/Layout.astro";

// Components
import CTAButton from "../components/CTAButton.astro";
import Card from "../components/Card.astro";

// images
import flightSearchImage from "../assets/case-studies/flight-search-results/flight-screens.png";
import hotelBookingImage from "../assets/case-studies/hotel-booking-flow/hotel-screens.png";
import { componentIsHTMLElement } from "astro/runtime/server/render/dom.js";
---

<Layout title="Home" description="Corey Prescott is a Product Designer with 14+ years of experience. I turn constraints into creative opportunities and build transparent, trustworthy experiences in close partnership with engineering." activePage="home">
<!-- Hero section -->
<section class="hero">
    <div class="hero-content">
        <div class="hero-text" aria-label="Hi, I'm Corey Prescott 👋">
            <h1>Hi, I'm Corey<span class="bye"> Prescott</span> 👋</h1>
            <p><strong>I'm a Product Designer</strong> with over 14 years designing and building for the web, the last 4 focused specifically on product and UX. I care about designing experiences people can trust, where the information they need is upfront, not buried.</p>

            <p>I've spent most of my career working closely with development. I don't see constraints as something to fight, but an opportunity to find a creative solution and push a little where it gets us something better.</p>
            <CTAButton text="View my work" href="#case-studies" size="md" variant="outline" />
        </div>
    </div>
</section>

<!-- Case studies section -->
<section class="case-studies-preview">
    <div class="case-studies-content">
        <h2 class="section-header" id="case-studies">Case studies</h2>
        <div class="card-grid">
        <!-- Card 1 -->
        <Card
            title="Flight search results"
            description="Optimizing flight search results for a modern shopping experience"
            imageSrc={flightSearchImage}
            imageAlt="Flight search mockup"
            linkHref="/work/flight-search-results"
        />

        <!-- Card 2 -->
        <Card
            title="Hotel booking flow"
            description="No surprises: Designing a transparent hotel booking flow"
            imageSrc={hotelBookingImage}
            imageAlt="Hotel booking mockup"
            linkHref="/work/hotel-booking-flow"
        />
        </div>
    </div>
</section>
</Layout>

<style>
.hero-content {
    max-width: 640px;
}

.case-studies-preview {
    padding: var(--spacing-lg) 0;
    text-align: left;
    background: var(--color-background-secondary);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
}

.case-studies-content {
    max-width: 640px;
    margin: 0 var(--spacing-md);
}

/* Card component */
.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-md);
    padding-bottom: var(--spacing-xs);
}

/* === Tablet and desktop (min-width: 768px) === */
@media (min-width: 768px) {
    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .case-studies-preview {
    padding: var(--spacing-2xl) 0;
    flex-direction: row;
    align-items: center;
    }

    .case-studies-content {
        flex: 1;
        margin: 0 var(--spacing-lg);
    }
}

/* === Desktop (min-width: 1024px) === */
@media (min-width: 1024px) {

}
</style>