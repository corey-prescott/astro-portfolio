---
import Layout from "../layouts/Layout.astro";

// Components
import CTAButton from "../components/CTAButton.astro";
import Card from "../components/Card.astro";

// images
import flightSearchImage from "../assets/case-studies/flight-search-results/flight-screens.png";
import hotelBookingImage from "../assets/case-studies/hotel-booking-flow/hotel-screens.png";
import { componentIsHTMLElement } from "astro/runtime/server/render/dom.js";
---

<Layout title="Home | Corey Prescott" activePage="home">
<!-- Hero section -->
<section class="hero">
    <div class="hero-content">
        <div class="hero-text">
            <h1>Corey Prescott</h1>
            <h2>Product Designer</h2>
            <p>Designing experiences you can trust, where information is upfront, not buried.</p>
            <CTAButton text="View my work" href="/work" size="md" variant="outline" />
        </div>
    </div>
</section>

<!-- Case studies section -->
<section class="case-studies-preview">
    <div class="case-studies-content">
        <h2 class="section-header">Case studies</h2>
        <div class="card-grid">
        <!-- Card 1 -->
        <Card
            title="Flight search results"
            description="Optimizing flight search results for a modern shopping experience"
            imageSrc={flightSearchImage}
            imageAlt="Flight search mockup"
            linkHref="/work/flight-search-results"
        />

        <!-- Card 2 -->
        <Card
            title="Hotel booking flow"
            description="No surprises: Designing a transparent hotel booking flow"
            imageSrc={hotelBookingImage}
            imageAlt="Hotel booking mockup"
            linkHref="/work/hotel-booking-flow"
        />
        </div>
    </div>
</section>

<!-- About preview section -->
<!-- <section class="about-preview">
    <div class="about-content">
        <h2 class="section-header">About me</h2>
        <p>I've been designing for the web for over 14 years, with the last 4 focused on product and UX. Much of that time has been spent working closely with development, figuring out where the real edges of an idea are and pushing a little past them.</p>
        <a href="/about">Learn more →</a>
    </div>
</section> -->
</Layout>

<style>
/* About preview */
.case-studies-preview, .about-preview {
    padding: var(--spacing-lg) 0;
    text-align: left;
    background: var(--color-background-secondary);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
}

.case-studies-content, .about-content {
    max-width: 1200px;
    margin: 0 var(--spacing-md);
}

/* Card component */
.card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--spacing-md);
    padding-bottom: var(--spacing-xs);
}

/* === Tablet and desktop (min-width: 768px) === */
@media (min-width: 768px) {
    .project-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .case-studies-preview, .about-preview {
    padding: var(--spacing-2xl) 0;
    flex-direction: row;
    align-items: center;
    }

    .case-studies-content, .about-content {
        flex: 1;
        margin: 0 var(--spacing-lg);
    }
}

/* === Desktop (min-width: 1024px) === */
@media (min-width: 1024px) {

}
</style>