---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home | Corey Prescott">
  <section class="hero">
    <h1>Hi, I'm [Your Name]</h1>
    <p>I'm a product designer</p>
    <a href="/work" class="cta-button">View my work</a>
  </section>
</Layout>

<style>
  /* PAGE-SPECIFIC styles ONLY */
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 80vh;
        text-align: center;
    }

    .cta-button {
        background: blueviolet;
        color: white;
        padding: 0.8rem 2rem;
        border-radius: 8px;
        text-decoration: none;
        margin-top: 2rem;
    }
</style>