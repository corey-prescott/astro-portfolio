---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home | Corey Prescott">
  <!-- === REPLACE EVERYTHING BELOW with your actual content === -->
  
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Corey Prescott</h1>
      <h2>Product Designer</h2>
      <a href="/work" class="cta">See my work</a>
    </div>
  </section>

  <!-- About Preview Section -->
  <section class="about-preview">
    <h2>About me</h2>
    <p>I care about designing experiences people can trust, where the information they need is upfront, not buried. I've been designing for the web for over 14 years, with the last 4 focused on product and UX. Much of that time has been spent working closely with development, figuring out where the real edges of an idea are and pushing a little past them.</p>
    <a href="/about">Learn more →</a>
  </section>

  <!-- Work Preview Section -->
  <section class="work-preview">
    <h2>Featured projects</h2>
    <div class="project-grid">
      <div class="project-card">
        <img src="/images/project-1.jpg" alt="Project 1" />
        <h3>Optimizing flight search results for a modern shopping experience</h3>
        <p>Brief description</p>
        <a href="/work/flight-search" class="card-link">Case study →</a>
      </div>

      <div class="project-card">
        <img src="/images/project-2.jpg" alt="Project 2" />
        <h3>No surprises: Designing a transparent hotel booking flow</h3>
        <p>Brief description</p>
        <a href="/work/hotel-booking" class="card-link">Case study →</a>
      </div>

      <div class="project-card">
        <img src="/images/project-3.jpg" alt="Project 3" />
        <h3>Some bullshit about checkout being better without Matt Molloy</h3>
        <p>Brief description</p>
        <a href="/work/checkout-flow" class="card-link">Case study →</a>
      </div>
    </div>
    <a href="/work" class="view-all">View all work →</a>
  </section>
</Layout>

<style>
  /* === MOBILE-FIRST STYLES (matches your screenshot) === */
  
  /* Reset and Base */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Hero Section */
  .hero {
    padding: 2rem 1.5rem;
    text-align: left;
    background: #f8f9fa; /* Replace with your color */
    height: 66vh;
    max-height: 500px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .hero h2 {
    margin-bottom: 2rem;
  }

  .hero p {
    font-size: 1.2rem;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .cta {
    display: inline-block;
    background: var(--color-primary);
    color: var(--text);
    padding: 0.8rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }

  .hero-image {
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  /* About Preview */
  .about-preview {
    padding: 3rem 1.5rem;
    text-align: left;
    background: white;
  }

  .about-preview h2 {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }

  .about-preview p {
    color: var(--text);
    margin-bottom: 1rem;
  }

  .about-preview a {
    color: #0070f3;
    text-decoration: none;
    font-weight: 600;
  }

  /* Work Preview */
  .work-preview {
    padding: 3rem 1.5rem;
    background: #f8f9fa;
    text-align: left;
  }

  .work-preview h2 {
    font-size: 1.8rem;
    margin-bottom: 2rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .project-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1rem;
    text-align: left;
  }

  .project-card img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
  }

  .project-card h3 {
    margin: 0.5rem 0;
  }

  .project-card p {
    color: var(--text);
    font-size: 0.9rem;
  }

  .view-all {
    color: #0070f3;
    text-decoration: none;
    font-weight: 600;
  }

  /* === Tablet and Desktop (min-width: 768px) === */
  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      text-align: left;
      padding: 4rem 3rem;
      gap: 4rem;
    }

    .hero-content {
      flex: 1;
    }

    .hero-image {
      flex: 1;
      max-width: 400px;
    }

    .hero h1 {
      font-size: 3.5rem;
    }

    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .about-preview, .work-preview {
      padding: 4rem 3rem;
    }
  }

  /* === Desktop (min-width: 1024px) === */
  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero {
      padding: 6rem 4rem;
    }

    .hero-image {
      max-width: 500px;
    }
  }
</style>